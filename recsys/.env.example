RECSYS_ADDR=127.0.0.1:8080

# Стенд разработки и векторного каталога (compose.yml, pgvector/pgvector:pg17).
# База исторической оценки (backtest v4/v5) использует отдельную строку подключения:
# в базу исторической оценки ежедневный фид и эмбеддинги витрины не загружают
# (в снимок v5-train-20260831 нельзя подмешивать фид новее 2026-08-31).
RECSYS_DEV_PG_PORT=55432
DATABASE_URL=postgres://recsys_dev:recsys_dev@127.0.0.1:55432/recsys_dev?sslmode=disable

# Полевое подключение PostgreSQL (используется только если DATABASE_URL и RECSYS_DATABASE_URL пусты)
HOST=127.0.0.1
PORT=55432
USER=recsys_dev
PASSWORD=
DATABASE=recsys_dev
SSLMODE=disable

# Настройки HTTP, сессий и миграций
RECSYS_REQUEST_TIMEOUT=10s
RECSYS_SESSION_TTL=24h
RECSYS_BCRYPT_COST=10
RECSYS_MIGRATIONS_DIR=migrations
RECSYS_OPENAPI_PATH=api/openapi.yaml
RECSYS_EXAMPLES_DIR=api/examples
RECSYS_MOCK=0

# Синтетические демо-аккаунты (только для cmd/seed на демо-стенде)
DEMO_B2B_LOGIN=demo-b2b
DEMO_B2B_PASSWORD=demo-b2b-pass
DEMO_B2C_LOGIN=demo-b2c
DEMO_B2C_PASSWORD=demo-b2c-pass

# Эмбеддинги каталога (cmd/embed-catalog / make embed-catalog).
# Укажите OpenAI-совместимый корень API (например http://127.0.0.1:11434/v1) и имя модели; секреты держите вне Git.
EMBED_BASE_URL=http://127.0.0.1:11434/v1
EMBED_API_KEY=
EMBED_MODEL=nomic-embed-text
EMBED_BATCH_SIZE=32

# Перестановка/объяснения через чат-модель по умолчанию ВЫКЛЮЧЕНЫ (оставьте пустыми):
# локальная модель часто не укладывается в бюджет 8 секунд, и онлайн-запрос только ждёт таймаута.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
