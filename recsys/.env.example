RECSYS_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/recsys?sslmode=disable

# Alternative plain PostgreSQL connection variables (used when DATABASE_URL and RECSYS_DATABASE_URL are unset)
HOST=localhost
PORT=5432
USER=postgres
PASSWORD=
DATABASE=recsys
SSLMODE=disable

# HTTP, session, and migration settings
RECSYS_REQUEST_TIMEOUT=10s
RECSYS_SESSION_TTL=24h
RECSYS_BCRYPT_COST=10
RECSYS_MIGRATIONS_DIR=migrations
RECSYS_OPENAPI_PATH=api/openapi.yaml
RECSYS_EXAMPLES_DIR=api/examples
RECSYS_MOCK=0

# Demo seed credentials (used only by cmd/seed on synthetic demo DB)
DEMO_B2B_LOGIN=demo-b2b
DEMO_B2B_PASSWORD=demo-b2b-pass
DEMO_B2C_LOGIN=demo-b2c
DEMO_B2C_PASSWORD=demo-b2c-pass

# Enrichment provider settings
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_BATCH_SIZE=
