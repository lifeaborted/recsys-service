# Подключение к БД (можно задать HOST/PORT/USER/PASSWORD/DATADASE
# или сразу RECSYS_DATABASE_URL — он имеет приоритет)
HOST=localhost
PORT=5432
USER=postgres
PASSWORD=
DATABASE=recsys
# DATADASE=ogo
SSLMODE=disable
MAINTENANCE_DB=postgres

# Схема и миграции
SCHEMA=recommendations
MIGRATIONS_DIR=migrations
MIGRATIONS_TABLE=schema_migrations

# API
RECSYS_ADDR=127.0.0.1:8080
API_MODEL_VERSION=go-baseline-1.0
API_FALLBACK_CLIENT_ID=C02417
API_USER_U1_CLIENT_ID=C02417
API_USER_U2_CLIENT_ID=C02417
API_USER_U3_CLIENT_ID=C02417
RECSYS_EXAMPLES_DIR=api/examples
RECSYS_MOCK=0

# Будущие настройки обогащения
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_BATCH_SIZE=
